{
  "name": "hospital-queue-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "setup": "cd backend && npm install && cd ../frontend && npm install",
    "db:setup": "cd backend && npm run db:setup",
    "test": "cd backend && npm test",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-release.ps1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
